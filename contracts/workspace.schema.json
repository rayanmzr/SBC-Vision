{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "card_id": {
          "exclusiveMinimum": 0,
          "title": "Card Id",
          "type": "integer"
        },
        "base_id": {
          "exclusiveMinimum": 0,
          "title": "Base Id",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rating": {
          "maximum": 99,
          "minimum": 1,
          "title": "Rating",
          "type": "integer"
        },
        "positions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Positions",
          "type": "array"
        },
        "nation_id": {
          "exclusiveMinimum": 0,
          "title": "Nation Id",
          "type": "integer"
        },
        "league_id": {
          "exclusiveMinimum": 0,
          "title": "League Id",
          "type": "integer"
        },
        "club_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Club Id"
        },
        "card_level": {
          "anyOf": [
            {
              "enum": [
                "BRONZE",
                "SILVER",
                "GOLD"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Card Level"
        },
        "item_score": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Score"
        },
        "chemistry_kind": {
          "default": "unsupported",
          "enum": [
            "standard",
            "unsupported"
          ],
          "title": "Chemistry Kind",
          "type": "string"
        },
        "max_quantity": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Quantity",
          "type": "integer"
        },
        "is_rare": {
          "title": "Is Rare",
          "type": "boolean"
        },
        "owned": {
          "title": "Owned",
          "type": "boolean"
        },
        "protected": {
          "default": false,
          "title": "Protected",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "observed_at": {
          "minLength": 1,
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "key",
        "card_id",
        "base_id",
        "name",
        "rating",
        "positions",
        "nation_id",
        "league_id",
        "is_rare",
        "owned",
        "source_url",
        "observed_at"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Challenge": {
      "additionalProperties": false,
      "properties": {
        "rules_version": {
          "const": "dynamic-v1",
          "default": "dynamic-v1",
          "title": "Rules Version",
          "type": "string"
        },
        "mode": {
          "default": "squad",
          "enum": [
            "squad",
            "score"
          ],
          "title": "Mode",
          "type": "string"
        },
        "positions": {
          "items": {
            "type": "string"
          },
          "maxItems": 11,
          "title": "Positions",
          "type": "array"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Conditions",
          "type": "array"
        },
        "max_items": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "score_progress": {
          "default": 0,
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Score Progress",
          "type": "integer"
        },
        "card_level": {
          "anyOf": [
            {
              "enum": [
                "BRONZE",
                "SILVER",
                "GOLD"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Card Level"
        },
        "card_level_op": {
          "default": "exact",
          "enum": [
            "min",
            "max",
            "exact"
          ],
          "title": "Card Level Op",
          "type": "string"
        },
        "market": {
          "enum": [
            "ps",
            "pc"
          ],
          "title": "Market",
          "type": "string"
        },
        "budget": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Budget",
          "type": "integer"
        },
        "max_card_value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Card Value"
        }
      },
      "required": [
        "market",
        "budget"
      ],
      "title": "Challenge",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "players",
            "rating",
            "rated",
            "rare",
            "nation",
            "league",
            "club",
            "nations",
            "leagues",
            "clubs",
            "same_nation",
            "same_league",
            "same_club",
            "quality",
            "item_score",
            "team_rating",
            "chemistry"
          ],
          "title": "Metric",
          "type": "string"
        },
        "op": {
          "default": "min",
          "enum": [
            "min",
            "max",
            "exact"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        },
        "target": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    }
  },
  "properties": {
    "mode": {
      "enum": [
        "demo",
        "local"
      ],
      "title": "Mode",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    },
    "price_reference_at": {
      "title": "Price Reference At",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Items",
      "type": "array"
    },
    "challenge": {
      "anyOf": [
        {
          "$ref": "#/$defs/Challenge"
        },
        {
          "type": "null"
        }
      ]
    },
    "challenge_issues": {
      "items": {
        "type": "string"
      },
      "title": "Challenge Issues",
      "type": "array"
    }
  },
  "required": [
    "mode",
    "revision",
    "price_reference_at",
    "items",
    "challenge",
    "challenge_issues"
  ],
  "title": "WorkspaceSnapshot",
  "type": "object"
}
