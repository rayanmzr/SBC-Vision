{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Boîte dans la capture : x, y en haut à gauche ; largeur/hauteur en pixels.",
      "properties": {
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "TextRegion": {
      "additionalProperties": false,
      "properties": {
        "element_id": {
          "minLength": 1,
          "title": "Element Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "name",
            "rating",
            "position",
            "item_score",
            "requirements",
            "slots"
          ],
          "title": "Field",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        }
      },
      "required": [
        "element_id",
        "field",
        "bbox"
      ],
      "title": "TextRegion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capture_id": {
      "minLength": 1,
      "title": "Capture Id",
      "type": "string"
    },
    "regions": {
      "items": {
        "$ref": "#/$defs/TextRegion"
      },
      "minItems": 1,
      "title": "Regions",
      "type": "array"
    },
    "positions": {
      "items": {
        "type": "string"
      },
      "maxItems": 11,
      "title": "Positions",
      "type": "array"
    },
    "attributes": {
      "additionalProperties": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "type": "object"
      },
      "title": "Attributes",
      "type": "object"
    }
  },
  "required": [
    "capture_id",
    "regions"
  ],
  "title": "OcrInput",
  "type": "object"
}
