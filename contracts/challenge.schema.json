{
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "players",
            "rating",
            "rated",
            "rare",
            "nation",
            "league",
            "club",
            "nations",
            "leagues",
            "clubs",
            "same_nation",
            "same_league",
            "same_club",
            "quality",
            "item_score",
            "team_rating",
            "chemistry"
          ],
          "title": "Metric",
          "type": "string"
        },
        "op": {
          "default": "min",
          "enum": [
            "min",
            "max",
            "exact"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        },
        "target": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rules_version": {
      "enum": [
        "prototype-v1",
        "dynamic-v1"
      ],
      "title": "Rules Version",
      "type": "string"
    },
    "mode": {
      "default": "squad",
      "enum": [
        "squad",
        "score"
      ],
      "title": "Mode",
      "type": "string"
    },
    "positions": {
      "items": {
        "type": "string"
      },
      "maxItems": 11,
      "title": "Positions",
      "type": "array"
    },
    "conditions": {
      "items": {
        "$ref": "#/$defs/Condition"
      },
      "title": "Conditions",
      "type": "array"
    },
    "max_items": {
      "default": 100,
      "maximum": 100,
      "minimum": 1,
      "title": "Max Items",
      "type": "integer"
    },
    "score_progress": {
      "default": 0,
      "maximum": 1000000000,
      "minimum": 0,
      "title": "Score Progress",
      "type": "integer"
    },
    "card_level": {
      "anyOf": [
        {
          "enum": [
            "BRONZE",
            "SILVER",
            "GOLD"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Card Level"
    },
    "market": {
      "enum": [
        "ps",
        "pc"
      ],
      "title": "Market",
      "type": "string"
    },
    "budget": {
      "maximum": 1000000000,
      "minimum": 0,
      "title": "Budget",
      "type": "integer"
    },
    "min_card_rating": {
      "default": 1,
      "maximum": 99,
      "minimum": 1,
      "title": "Min Card Rating",
      "type": "integer"
    },
    "min_rare": {
      "default": 0,
      "maximum": 11,
      "minimum": 0,
      "title": "Min Rare",
      "type": "integer"
    },
    "nation_id": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nation Id"
    },
    "min_nation": {
      "default": 0,
      "maximum": 11,
      "minimum": 0,
      "title": "Min Nation",
      "type": "integer"
    },
    "league_id": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "League Id"
    },
    "min_league": {
      "default": 0,
      "maximum": 11,
      "minimum": 0,
      "title": "Min League",
      "type": "integer"
    }
  },
  "required": [
    "rules_version",
    "market",
    "budget"
  ],
  "title": "Challenge",
  "type": "object"
}
