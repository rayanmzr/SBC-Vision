# Configuration du socle API.
SBC_ENV=development

# Vision : disabled par défaut ; lab-colors pour le laboratoire fictif uniquement.
SBC_PERCEPTION_MODE=disabled

# Espace SBC : désactivé sans configuration explicite. Voir docs/SBC_API.md.
SBC_ENGINE_MODE=disabled
SBC_ENGINE_DATABASE=
SBC_ENGINE_CHALLENGE=

# Intervalle minimum lu par l'importeur (au moins deux secondes entre requêtes).
FUTBIN_MIN_INTERVAL_SECONDS=2

# Variables réservées aux briques à implémenter ; aucune action n'est activée.
CONTROLLER_EXECUTION_MODE=disabled
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
