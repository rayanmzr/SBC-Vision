# Configuration du socle API.
SBC_ENV=development

# Partage : clé obligatoire en mode shared (et par défaut avec SBC_ENV=production).
SBC_ACCESS_MODE=local
SBC_API_KEY=
SBC_API_KEY_FILE=
SBC_MAX_INFLIGHT=4

# Vision EA : poids locaux vérifiés ; lab-colors sert seulement aux tests hors compte EA.
SBC_PERCEPTION_MODE=disabled
SBC_DETECTOR=yolo:data/processed/models/yolo26s-easysbc-ft-s0.onnx
SBC_DETECTION_THRESHOLD=0.61
SBC_CARD_LAYOUT=club-list

# OCR de Rayan : régions fournies, sans détecteur. Voir docs/OCR_API.md.
SBC_OCR_MODE=disabled
SBC_OCR_LANG=eng

# Espace SBC : désactivé sans configuration explicite. Voir docs/SBC_API.md.
SBC_ENGINE_MODE=disabled
SBC_ENGINE_DATABASE=
SBC_ENGINE_CHALLENGE=

# Intervalle minimum lu par l'importeur (au moins deux secondes entre requêtes).
FUTBIN_MIN_INTERVAL_SECONDS=2

# Variables réservées aux briques à implémenter ; aucune action n'est activée.
CONTROLLER_EXECUTION_MODE=disabled
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
